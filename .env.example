ASSET_HUB_HOST=assets.kuruk.in
STACK_NAME=kurukin-asset-hub
POSTGRES_DB=kurukin_asset_hub
POSTGRES_USER=asset_hub
POSTGRES_PASSWORD=change-me
DATABASE_URL=postgresql+psycopg://asset_hub:change-me@tasks.db:5432/kurukin_asset_hub
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-me
ASSET_HUB_API_KEY=change-me
PREVIEW_STORAGE_DIR=/data/previews
JOB_ASSETS_STORAGE_DIR=/data/job-assets
JOB_ASSET_MATERIALIZATION_ENABLED=true
OPENAI_API_KEY=
NVIDIA_API_KEY=
AI_ENRICHMENT_ENABLED=false
AI_PROVIDER=openai
AI_MODEL=
AI_OUTPUT_LANGUAGE=es
AI_FRAME_SAMPLE_COUNT=8
AI_REVIEW_THRESHOLD=0.72
AI_MAX_ASSETS_PER_BATCH=20
ASSET_PIPELINE_ENABLED=true
ASSET_PIPELINE_POLL_SECONDS=30
ASSET_PIPELINE_BATCH_SIZE=10
LONG_VIDEO_SEGMENTATION_ENABLED=true
LONG_VIDEO_THRESHOLD_SECONDS=30
SEGMENT_MIN_SECONDS=4
SEGMENT_TARGET_SECONDS=8
SEGMENT_MAX_SECONDS=15
SEGMENT_SCENE_THRESHOLD=0.32
SEGMENT_OUTPUT_MODE=high_quality_encode
SEGMENT_OUTPUT_CRF=17
SEGMENT_OUTPUT_PRESET=medium
SEGMENT_STRIP_AUDIO=true
# Derived b-roll upload paths are configured per Source or with the segmentation CLI.
# Usually leave the derived root empty when the rclone remote already points at derived-brolls;
# then children are uploaded and stored as <category>/<filename>.
DERIVED_ASSET_CATEGORY_FOLDERS=women,men,couples,animals,family,business,nature,food,health,abstract,spiritual,other
APP_ENV=production
LOG_LEVEL=INFO
